# InstaEditLogin — canonical test environment
#
# Used by local test runs and CI-style integration checks. Copy to the ignored
# runtime file when a test needs dotenv loading:
#   cp .env.test.example .env.test
# Never use these values outside tests and never point tests at production.

APP_ENV=dev
APP_MODE=dev
PORT=8081
LOG_LEVEL=error
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
COOKIE_DOMAIN=
# Canonical InstaEditor URL; EDITOR_URL is intentionally not read.
INSTAEDITOR_URL=
TRUSTED_PROXIES=

# Use a dedicated disposable test database.
POSTGRES_USER=instaedit
POSTGRES_PASSWORD=test_password
POSTGRES_DB=instaedit_login_test
DATABASE_URL=postgresql://instaedit:test_password@127.0.0.1:5432/instaedit_login_test?sslmode=disable
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=instaedit
DB_PASSWORD=test_password
DB_NAME=instaedit_login_test
DB_SSLMODE=disable

# Storage tests use a disposable MinIO/S3-compatible endpoint when enabled.
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=instaedit-test
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=test-access-key
S3_SECRET_KEY=test-secret-key
MINIO_ROOT_USER=test-access-key
MINIO_ROOT_PASSWORD=test-secret-key
STORAGE_MAX_UPLOAD_BYTES=209715200
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# OAuth is disabled by default; individual tests may inject provider values.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/meta/callback
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/instagram/callback
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/facebook/callback
THREADS_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/threads/callback
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/tiktok/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/twitter/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/youtube/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/google-drive/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/linkedin/callback

# Deterministic values are acceptable only in disposable tests.
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=1
JWT_TTL_HOURS=1
STRICT_JWT_AUTH=true
ADMIN_INVITE_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ENCRYPTION_KEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=
# Do not set ENCRYPTION_KEYS together with ENCRYPTION_KEY.

# Keep worker loops short for tests that exercise them.
PUBLISH_WORKER_INTERVAL_SECONDS=5
PUBLISH_CONCURRENCY=4
YOUTUBE_COPYRIGHT_CHECK_INTERVAL_SECONDS=5
# Cadence of the async NVIDIA metadata generation worker (migration 113).
METADATA_GENERATION_WORKER_INTERVAL_SECONDS=5
RECONCILE_WORKER_INTERVAL_SECONDS=1
WEBHOOK_WORKER_INTERVAL_SECONDS=1
SESSION_CLEANUP_INTERVAL_SECONDS=5
ASSET_CLEANUP_INTERVAL_SECONDS=60
UPLOAD_WORKER_INTERVAL_SECONDS=5
UPLOAD_INGEST_CONCURRENCY=1
YOUTUBE_UPLOAD_CONCURRENCY=1
UPLOAD_LEASE_TTL_SECONDS=10
UPLOAD_HEARTBEAT_INTERVAL_SECONDS=2
UPLOAD_RECLAIM_INTERVAL_SECONDS=5
UPLOAD_RECLAIM_ON_START=false
PUBLISH_HORIZON_DAYS=30
VIDEO_RETENTION_BUFFER_DAYS=7
YOUTUBE_UPLOAD_CHUNK_BYTES=16777216
YOUTUBE_UPLOAD_MAX_RETRIES=1
YOUTUBE_UPLOAD_BACKOFF_BASE_MS=10
YOUTUBE_UPLOAD_BACKOFF_CAP_MS=100
YOUTUBE_DAILY_UPLOAD_LIMIT=100
YOUTUBE_SEARCH_QUOTA_LIMIT=100
YOUTUBE_GENERAL_QUOTA_LIMIT=10000
YOUTUBE_GROUP_VIDEOS_MAX_ACCOUNTS=200
YOUTUBE_GROUP_VIDEOS_MAX_VIDEOS=500
YOUTUBE_GROUP_VIDEOS_CACHE_TTL_SECONDS=0
YOUTUBE_GROUP_VIDEOS_DEFAULT_PAGE_SIZE=50

# Integrations disabled for tests unless a test explicitly enables them.
VELOX_INTEGRATION_ENABLED=false
VELOX_CONTROL_URL=
VELOX_CONTROL_JWT_SECRET=
VELOX_API_TOKEN=
VELOX_WEBHOOK_SECRET=
VELOX_DOWNLOAD_TIMEOUT_SECONDS=60
VELOX_MAX_ARTIFACT_BYTES=1048576
VELOX_CALLBACK_MAX_ATTEMPTS=1
VELOX_CALLBACK_BASE_DELAY_MS=10
NVIDIA_API_KEY=
NVIDIA_MODEL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=test
SENTRY_RELEASE=
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=
METRICS_HOST=
METRICS_PORT=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://127.0.0.1:5173/dashboard/billing?success=1
STRIPE_CANCEL_URL=http://127.0.0.1:5173/dashboard/billing?canceled=1
BOOKING_HASH_SECRET=
VERCEL_TOKEN=

# Token refresh sweep — renews dormant OAuth grants before Google's ~6-month inactivity GC.
# 15-minute cadence + 4-month horizon (2 months of margin under the 6-month rule).
TOKEN_REFRESH_SWEEP_INTERVAL_SECONDS=900
TOKEN_REFRESH_SWEEP_HORIZON_DAYS=120
