# Template only. Never commit the populated production file.
# Install the populated file as /etc/instaeditlogin-youtube.env with:
#   owner root:root
#   mode 600
#
# EnvironmentFile syntax is KEY=value. Keep JSON compact and single-line.
# Values below are intentionally empty/placeholders.

# OAuth consent-screen publishing mode. Keep this aligned with Google Cloud
# Console: testing for staging/test clients, production only after verification
# and publishing. Local development may use dev.
APP_MODE=production

# YouTube OAuth configuration.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/youtube/callback

# Encryption: use either the legacy single-key form OR the key-ring form,
# never both. Existing installations may keep ENCRYPTION_KEY during migration.
ENCRYPTION_KEY=
# ENCRYPTION_KEYS=1:<base64-32-byte-key>[,2:<base64-32-byte-key>]
# ACTIVE_ENCRYPTION_KEY_ID=1

# Other sensitive values previously embedded in the systemd unit must also
# live here if that unit uses them. Leave provider pairs unset to disable them.
# Keep client IDs and secrets together in this protected host-only file.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Runtime secrets migrated out of the unit file.
JWT_SECRET=
ADMIN_INVITE_TOKEN=
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=
VELOX_CONTROL_JWT_SECRET=
