[Unit]
Description=InstaEdit PostgreSQL weekly restore verification
Requires=docker.service
After=docker.service instaedit-db-backup.service instaedit-db-backup.timer

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/instaedit-db-restore-check
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run/lock
TimeoutStartSec=45min
