# Public VPS reverse proxy for the InstaEdit API.
#
# Requires DNS A api.instaedit.org -> this VPS and TCP ports 80/443 open.
# The Go API listens on 127.0.0.1:8080. The frontend is served EXCLUSIVELY
# by Vercel (app.instaedit.org) — this Caddy never serves the SPA and no
# longer carries the legacy dev.instaedit.org compatibility host (removed
# 2026-08-07: Dark Editor, MinIO proxy, and SPA redirects are gone).
#
# All routing lives in `handle` blocks so Caddy evaluates them in file
# order (the `handle` directive is exempt from directive sorting).

api.instaedit.org {
	encode gzip

	# /internal/* is closed at the proxy layer: those routes are
	# auth-gated service-to-service endpoints (Velox handoff) and must
	# never be reachable from the public Internet.
	handle /internal/* {
		abort
	}

	# ── Public media endpoint (OPTIONAL, disabled by default) ──────────
	# MinIO is PRIVATE in the canonical production stack: the API/worker
	# containers reach it via Compose DNS (S3_ENDPOINT=http://minio:9000)
	# and no host port is published (see docker-compose.production.yml).
	#
	# If browser uploads/previews must PUT/GET MinIO directly through
	# presigned URLs, enable a public media endpoint on THIS host (no new
	# subdomain) by:
	#   1. publishing MinIO on the VPS loopback, e.g. 127.0.0.1:19000:9000;
	#   2. setting S3_ENDPOINT=https://api.instaedit.org (S3_PATH_STYLE=true)
	#      in the production secret file;
	#   3. uncommenting the handle below so path-style presigned URLs
	#      ({host}/{bucket}/{key}) resolve to MinIO.
	#
	# handle /instaedit-media/* {
	# 	reverse_proxy 127.0.0.1:19000 {
	# 		header_up Host {host}
	# 	}
	# }

	# Everything else goes to the Go API.
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
