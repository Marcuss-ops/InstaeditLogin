# Public VPS reverse proxy for dev.instaedit.org and api.instaedit.org.
# Requires DNS A dev.instaedit.org + api.instaedit.org -> this VPS and
# TCP ports 80/443 open. The Go API listens on 127.0.0.1:8080.

# ── API ────────────────────────────────────────────────────────────────────
# Dedicated public hostname for the JSON API. No SPA, no S3 fallback:
# every request routes to the Go API on loopback; /internal/* is closed
# at the proxy layer so probes see nothing (no Fly fingerprint, no SQL
# hints, no Velox token-leak surface). encode gzip covers the JSON
# responses (the Go API honours Accept-Encoding: gzip on the read side).
api.instaedit.org {
	encode gzip

	handle /internal/* {
		abort
	}

	reverse_proxy 127.0.0.1:8080
}

# ── Dev web SPA ────────────────────────────────────────────────────────────
dev.instaedit.org {
	encode gzip
	log

	# The SPA shell must be revalidated after every deployment. Without this,
	# a remote browser can keep an old route bundle in its HTTP cache and call
	# protected endpoints with a stale session flow.
	@spa_shell path / /index.html /login* /app* /connections* /groups*
	header @spa_shell Cache-Control "no-store, no-cache, must-revalidate"

	# Never expose internal Velox routes through the public proxy.
	handle /internal/* {
		abort
	}

	# Keep /api intact: the Go router mounts at /api/v1/....
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Path-style presigned S3 URLs generated by the local API.
	handle /instaedit-local/* {
		reverse_proxy 127.0.0.1:19000 {
			header_up Host {host}
		}
	}

	# React SPA with client-side route fallback.
	handle {
		root * /srv/instaedit/web/dist
		try_files {path} /index.html
		file_server
	}
}
