# Public VPS reverse proxy for dev.instaedit.org and api.instaedit.org.
# Requires DNS A dev.instaedit.org + api.instaedit.org -> this VPS and
# TCP ports 80/443 open. The Go API listens on 127.0.0.1:8080.

# ── API ────────────────────────────────────────────────────────────────────
# Dedicated public hostname for the JSON API. No SPA, no S3 fallback:
# every request routes to the Go API on loopback; /internal/* is closed
# at the proxy layer so probes see nothing (no Fly fingerprint, no SQL
# hints, no Velox token-leak surface). encode gzip covers the JSON
# responses (the Go API honours Accept-Encoding: gzip on the read side).
api.instaedit.org {
	encode gzip

	handle /internal/* {
		abort
	}

	reverse_proxy 127.0.0.1:8080
}

# ── Backend compatibility hostname ─────────────────────────────────────────
# dev.instaedit.org is the legacy hostname. Backend paths (API, probes,
# Dark Editor, S3 media proxy) keep working here; every other path is a
# legacy SPA route and is permanently redirected (301) to the canonical
# frontend on Vercel (app.instaedit.org) instead of hitting the API 404.
# Path is preserved so client-side routing still works on the target.
dev.instaedit.org {
	encode gzip

	handle /internal/* {
		abort
	}

	# Dark Editor (Next.js) under the same base path returned by the API.
	handle /dark_editor_v2 {
		reverse_proxy 127.0.0.1:3001
	}
	handle /dark_editor_v2/* {
		reverse_proxy 127.0.0.1:3001
	}

	# S3-compatible MinIO proxy for browser uploads and media previews.
	# Presigned URLs are signed for this public HTTPS host, so preserve it
	# when forwarding to the host-published MinIO port.
	handle /instaedit-local/* {
		reverse_proxy 127.0.0.1:19000 {
			header_up Host {host}
		}
	}
	handle /instaedit-media/* {
		reverse_proxy 127.0.0.1:19000 {
			header_up Host {host}
		}
	}

	# API + probes keep working on the legacy hostname (OAuth callbacks,
	# /ready, health). Explicit handlers are required now that the catch-all
	# no longer proxies to the Go API.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /ready {
		reverse_proxy 127.0.0.1:8080
	}

	# Everything else is a legacy SPA route → canonical frontend on Vercel.
	handle {
		redir https://app.instaedit.org{uri} permanent
	}
}
