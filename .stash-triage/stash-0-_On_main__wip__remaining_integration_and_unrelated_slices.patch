+package worker
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDriveBatchCrawlerDefaultsPreparationLeadTime(t *testing.T) {
+	c := &DriveBatchCrawler{}
+	c.applyDefaults()
+	if c.opts.PrepareLeadTime != 15*time.Minute {
+		t.Fatalf("default preparation lead time = %s, want 15m", c.opts.PrepareLeadTime)
+	}
+}
+
+func TestPreparationLeadTimeIsBeforePublishCursor(t *testing.T) {
+	c := &DriveBatchCrawler{opts: DriveBatchCrawlerOptions{PrepareLeadTime: 15 * time.Minute}}
+	publishAt := time.Now().Add(30 * time.Minute)
+	prepareAt := publishAt.Add(-c.opts.PrepareLeadTime)
+	if !prepareAt.Before(publishAt) {
+		t.Fatalf("prepare_at %s is not before publish_at %s", prepareAt, publishAt)
+	}
+	if got := publishAt.Sub(prepareAt); got != 15*time.Minute {
+		t.Fatalf("preparation window = %s, want 15m", got)
+	}
+}
