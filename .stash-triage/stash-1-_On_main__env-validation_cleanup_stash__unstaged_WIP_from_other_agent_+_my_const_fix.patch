+
+// DriftObservation (drift-recon) is the snapshot the periodic YouTube
+// Data API drift worker compares against the local DB row. 3-axis
+// drift (privacy, processing, publishAt).
+type DriftObservation struct {
+	PrivacyStatus    string     `json:"privacyStatus"`
+	ProcessingStatus string     `json:"processingStatus"`
+	PublishAt        *time.Time `json:"publishAt,omitempty"`
+}
+
+// QueryVideoLiveState (drift-recon) fetches live YouTube Data API state
+// for videoID via GET videos.list?part=status,processingDetails.
+// Returns the 3-axis DriftObservation.
+func (s *YouTubeOAuthService) QueryVideoLiveState(ctx context.Context, accessToken, videoID string) (*DriftObservation, error) {
+	video, err := s.fetchVideoStatus(ctx, accessToken, videoID)
+	if err != nil {
+		return nil, err
+	}
+	obs := &DriftObservation{PrivacyStatus: "", ProcessingStatus: "", PublishAt: nil}
+	if video.Status.PrivacyStatus != "" {
+		obs.PrivacyStatus = strings.ToLower(strings.TrimSpace(video.Status.PrivacyStatus))
+		if video.Status.PublishAt != "" {
+			if t, perr := time.Parse(time.RFC3339, video.Status.PublishAt); perr == nil {
+				obs.PublishAt = &t
+			}
+		}
+	}
+	if video.ProcessingDetails != nil {
+		obs.ProcessingStatus = video.ProcessingDetails.ProcessingStatus
+	}
+	return obs, nil
+}
