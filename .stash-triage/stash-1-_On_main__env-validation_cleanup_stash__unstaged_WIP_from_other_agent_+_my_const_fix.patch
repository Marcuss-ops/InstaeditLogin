+// true SQL NULL on the column. The DTO's `omitempty` behaviour then
+// hides the field from the JSON response.
+//
+// youtubeUpdatedAt is supplied by the worker (time.Now().UTC()) so
+// the timestamp agrees to the microsecond with the operator's
+// expectation: "the last verified reading of YouTube was at the
+// moment I looked". CAS-row + repo CAS ensures no drift between
+// the worker reading and the row stamping.
+//
+// syncStatus is constrained at the DB layer (CHECK constraint,
+// migration 072). The application is the single source of truth
+// for the four lifecycle values; overlaying an allow-list at this
+// layer would just drift the truth away from the DB constraint.
+//
+// Returns ErrYouTubeVideoEditNotFound (wrapped) on 0-rows — the
+// handler maps to a non-error skip (the row was deleted between
+// the list and the CAS). A real *sql.DB error propagates wrapped.
+func (r *YouTubeVideoEditRepository) UpdateYouTubeSyncState(
+	ctx context.Context,
+	id string,
+	actualPrivacy string,
+	youtubeUpdatedAt time.Time,
+	syncStatus string,
+) (*models.YouTubeVideoEdit, error) {
+	edit := &models.YouTubeVideoEdit{}
+	err := r.db.QueryRowContext(ctx,
+		`UPDATE youtube_video_edits
+		 SET actual_privacy = NULLIF($2, ''),
+		     youtube_updated_at = $3,
+		     youtube_sync_status = $4,
+		     updated_at = NOW()
+		 WHERE id = $1
+		 RETURNING `+youtubeVideoEditSelectColumns,
+		id, actualPrivacy, youtubeUpdatedAt, syncStatus,
+	).Scan(
+		&edit.ID, &edit.WorkspaceID, &edit.PlatformAccountID, &edit.YouTubeVideoID,
+		&edit.VeloxProjectID, &edit.SourceThumbnailURL, &edit.ThumbnailMediaID,
+		&edit.DesiredPrivacy, &edit.PublishAt, &edit.Status, &edit.LastError,
+		&edit.ActualPrivacy, &edit.YouTubeSyncStatus, &edit.YouTubeUpdatedAt,
+		&edit.CreatedAt, &edit.UpdatedAt,
+	)
+	if err == sql.ErrNoRows {
+		return nil, fmt.Errorf("%w: id=%s", ErrYouTubeVideoEditNotFound, id)
+	}
+	if err != nil {
+		return nil, fmt.Errorf("youtube video edit UpdateYouTubeSyncState: %w", err)
+	}
+	return edit, nil
+}
