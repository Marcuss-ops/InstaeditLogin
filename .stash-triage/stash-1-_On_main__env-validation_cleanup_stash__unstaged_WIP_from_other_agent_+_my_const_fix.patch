 	return errors.New("ciphertext stale: row not found (mock)")
 }
 
+func (m *mockTokenStore) UpdateRefreshTokenCiphertext(tokenID int64, oldEncrypted, newEncrypted []byte) error {
+	for _, bucket := range m.state {
+		for _, t := range bucket {
+			if t.ID == tokenID {
+				if !bytes.Equal(t.EncryptedRefreshToken, oldEncrypted) {
+					return errors.New("refresh ciphertext stale: another re-encrypt already applied (mock)")
+				}
+				t.EncryptedRefreshToken = newEncrypted
+				return nil
+			}
+		}
+	}
+	return errors.New("refresh ciphertext stale: row not found (mock)")
+}
