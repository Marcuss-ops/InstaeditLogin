+	}
+	result, err := r.db.Exec(qUpdateTargetContentHash, hash, id)
+	if err != nil {
+		var pqErr *pq.Error
+		if errors.As(err, &pqErr) && pqErr.Code == "23505" && pqErr.Constraint == "post_targets_account_content_hash_uniq" {
+			return fmt.Errorf("%w: id=%d", ErrContentDuplicate, id)
+		}
+		return fmt.Errorf("failed to set content_hash: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("failed to read rows affected: %w", err)
+	}
+	if n == 0 {
+		return fmt.Errorf("%w: id=%d", ErrPostTargetNotFound, id)
+	}
+	return nil
+}
