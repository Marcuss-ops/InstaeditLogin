+// --- State-machine helpers ---
+
+// TransitionTargetStatus atomically transitions a single target from one
+// status to another, validating the transition. It returns ErrPostTargetNotFound
+// when no row matches or the current status is unexpected.
+func (r *PostRepository) TransitionTargetStatus(id int64, from, to models.PostStatus) error {
+	if !models.CanTransition(from, to) {
+		return fmt.Errorf("invalid status transition %s -> %s", from, to)
+	}
+	result, err := r.db.Exec(
+		`UPDATE post_targets
+		 SET status = $1, version = version + 1, updated_at = NOW()
+		 WHERE id = $2 AND status = $3`,
+		to, id, from,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to transition target status: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("failed to read rows affected: %w", err)
+	}
+	if n == 0 {
+		return fmt.Errorf("%w: id=%d", ErrPostTargetNotFound, id)
+	}
+	return nil
+}
+
+// TransitionPostStatus atomically transitions a post from one status to another.
+func (r *PostRepository) TransitionPostStatus(id int64, from, to models.PostStatus) error {
+	if !models.CanTransition(from, to) {
+		return fmt.Errorf("invalid status transition %s -> %s", from, to)
+	}
+	result, err := r.db.Exec(
+		`UPDATE posts
+		 SET status = $1, version = version + 1, updated_at = NOW()
+		 WHERE id = $2 AND status = $3`,
+		to, id, from,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to transition post status: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("failed to read rows affected: %w", err)
+	}
+	if n == 0 {
+		return fmt.Errorf("%w: id=%d", ErrPostNotFound, id)
+	}
+	return nil
+}
+
+// RetryPost resets all failed targets of a post to scheduled and transitions
+// the post itself from failed to scheduled. This is the "retry" action from
+// the API.
+func (r *PostRepository) RetryPost(id int64) error {
+	tx, err := r.db.Begin()
+	if err != nil {
+		return fmt.Errorf("failed to begin retry tx: %w", err)
+	}
+	defer func() {
+		if err != nil {
+			_ = tx.Rollback()
+		}
+	}()
+
+	_, err = tx.Exec(
+		`UPDATE post_targets
+		 SET status = 'scheduled', version = version + 1, updated_at = NOW(), error_message = NULL
+		 WHERE post_id = $1 AND status = 'failed'`,
+		id,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to retry post targets: %w", err)
+	}
+
+	result, err := tx.Exec(
+		`UPDATE posts
+		 SET status = 'scheduled', version = version + 1, updated_at = NOW()
+		 WHERE id = $1 AND status = 'failed'`,
+		id,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to retry post: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("failed to read rows affected: %w", err)
+	}
+	if n == 0 {
+		// The post may already be scheduled/published/draft; still commit target retry.
+	}
+
+	if err = tx.Commit(); err != nil {
+		return fmt.Errorf("failed to commit retry tx: %w", err)
+	}
+	return nil
+}
+
+// CancelPost transitions a scheduled post back to draft and cancels any
+// scheduled targets.
+func (r *PostRepository) CancelPost(id int64) error {
+	tx, err := r.db.Begin()
+	if err != nil {
+		return fmt.Errorf("failed to begin cancel tx: %w", err)
+	}
+	defer func() {
+		if err != nil {
+			_ = tx.Rollback()
+		}
+	}()
+
+	_, err = tx.Exec(
+		`UPDATE post_targets
+		 SET status = 'draft', version = version + 1, updated_at = NOW()
+		 WHERE post_id = $1 AND status = 'scheduled'`,
+		id,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to cancel post targets: %w", err)
+	}
+
+	result, err := tx.Exec(
+		`UPDATE posts
+		 SET status = 'draft', scheduled_at = NULL, version = version + 1, updated_at = NOW()
+		 WHERE id = $1 AND status = 'scheduled'`,
+		id,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to cancel post: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("failed to read rows affected: %w", err)
+	}
+	if n == 0 {
+		err = fmt.Errorf("%w: id=%d", ErrPostNotFound, id)
+		return err
+	}
+
+	if err = tx.Commit(); err != nil {
+		return fmt.Errorf("failed to commit cancel tx: %w", err)
+	}
+	return nil
+}
+
+// PublishPost immediately schedules a post for now by setting scheduled_at
+// to NOW() and status to scheduled. The worker will pick it up on the next
+// tick.
+func (r *PostRepository) PublishPost(id int64) error {
+	result, err := r.db.Exec(
+		`UPDATE posts
+		 SET status = 'scheduled', scheduled_at = NOW(), version = version + 1, updated_at = NOW()
+		 WHERE id = $1 AND status IN ('draft', 'scheduled', 'failed')`,
+		id,
+	)
+	if err != nil {
+		return fmt.Errorf("failed to publish post: %w", err)
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("failed to read rows affected: %w", err)
+	}
+	if n == 0 {
+		return fmt.Errorf("%w: id=%d", ErrPostNotFound, id)
+	}
+	return nil
+}
+
+// RetryTarget resets a single failed target to scheduled.
+func (r *PostRepository) RetryTarget(id int64) error {
+	return r.TransitionTargetStatus(id, models.PostStatusFailed, models.PostStatusScheduled)
+}
+
+// --- MediaAssets ---
+
+// AddMediaAsset inserts a media asset linked to a post.
+func (r *PostRepository) AddMediaAsset(asset *models.MediaAsset) error {
+	return r.db.QueryRow(
+		`INSERT INTO media_assets (post_id, url, mime_type, size_bytes)
+		 VALUES ($1, $2, $3, $4)
+		 RETURNING id, created_at`,
+		asset.PostID, asset.URL, asset.MimeType, asset.SizeBytes,
+	).Scan(&asset.ID, &asset.CreatedAt)
+}
+
+// ListMediaAssets returns all media assets for a post.
+func (r *PostRepository) ListMediaAssets(postID int64) ([]models.MediaAsset, error) {
+	rows, err := r.db.Query(
+		`SELECT id, post_id, url, mime_type, size_bytes, created_at
+		 FROM media_assets
+		 WHERE post_id = $1
+		 ORDER BY id ASC`,
+		postID,
+	)
+	if err != nil {
+		return nil, fmt.Errorf("failed to list media assets: %w", err)
+	}
+	defer rows.Close()
+
+	var assets []models.MediaAsset
+	for rows.Next() {
+		a := models.MediaAsset{}
+		if err := rows.Scan(&a.ID, &a.PostID, &a.URL, &a.MimeType, &a.SizeBytes, &a.CreatedAt); err != nil {
+			return nil, fmt.Errorf("failed to scan media asset: %w", err)
+		}
+		assets = append(assets, a)
+	}
+	return assets, nil
+}
