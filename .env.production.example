# InstaEditLogin — canonical self-hosted production environment
#
# Copy this template to the VPS secret file, not into the Git checkout:
#   /opt/instaedit/secrets/.env.production (mode 0600)
# Replace every REPLACE_* value from the approved secret manager. Never commit
# the populated file, print it, or pass secrets as command-line arguments.
# The supported production topology is Docker Compose + PostgreSQL + MinIO on
# the VPS, with Caddy in front and Vercel hosting only the frontend.

# Application and HTTP
APP_ENV=production
APP_MODE=production
PORT=8080
API_HOST_PORT=8080
LOG_LEVEL=info
FRONTEND_URL=https://app.instaedit.org
CORS_ALLOWED_ORIGINS=https://app.instaedit.org
COOKIE_DOMAIN=.instaedit.org
# Canonical InstaEditor URL. Required in production; no EDITOR_URL fallback is supported.
INSTAEDITOR_URL=https://app.instaedit.org/dark_editor_v2
TRUSTED_PROXIES=127.0.0.1

# PostgreSQL (Compose service name is db)
POSTGRES_USER=instaedit
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=instaedit_login
DATABASE_URL=postgresql://instaedit:REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD@db:5432/instaedit_login?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_USER=instaedit
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
DB_NAME=instaedit_login
DB_SSLMODE=disable

# MinIO (the only production S3-compatible object store)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=instaedit-prod-media
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=instaedit
S3_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
MINIO_ROOT_USER=instaedit
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
STORAGE_MAX_UPLOAD_BYTES=209715200
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# Meta OAuth (Instagram, Facebook, and Threads)
META_APP_ID=REPLACE_WITH_PRODUCTION_META_APP_ID
META_APP_SECRET=REPLACE_WITH_PRODUCTION_META_APP_SECRET
META_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/meta/callback
INSTAGRAM_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/instagram/callback
FACEBOOK_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/facebook/callback
THREADS_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/threads/callback

# TikTok OAuth
TIKTOK_CLIENT_ID=REPLACE_WITH_PRODUCTION_TIKTOK_CLIENT_ID
TIKTOK_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_TIKTOK_CLIENT_SECRET
TIKTOK_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/tiktok/callback

# X/Twitter OAuth 2.0 PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/twitter/callback

# YouTube OAuth and resumable-upload tuning
YOUTUBE_CLIENT_ID=REPLACE_WITH_PRODUCTION_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_YOUTUBE_CLIENT_SECRET
YOUTUBE_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/youtube/callback
YOUTUBE_OAUTH_CLIENT_A_ID=
YOUTUBE_OAUTH_CLIENT_A_SECRET=
YOUTUBE_OAUTH_CLIENT_A_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/youtube/callback
YOUTUBE_OAUTH_CLIENT_B_ID=
YOUTUBE_OAUTH_CLIENT_B_SECRET=
YOUTUBE_OAUTH_CLIENT_B_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/youtube/callback
YOUTUBE_UPLOAD_CHUNK_BYTES=16777216
YOUTUBE_UPLOAD_MAX_RETRIES=5
YOUTUBE_UPLOAD_BACKOFF_BASE_MS=1000
YOUTUBE_UPLOAD_BACKOFF_CAP_MS=300000
YOUTUBE_DAILY_QUOTA_LIMIT=300
YOUTUBE_GROUP_VIDEOS_MAX_ACCOUNTS=200
YOUTUBE_GROUP_VIDEOS_MAX_VIDEOS=500
YOUTUBE_GROUP_VIDEOS_CACHE_TTL_SECONDS=300
YOUTUBE_GROUP_VIDEOS_DEFAULT_PAGE_SIZE=50

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/google-drive/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.instaedit.org/api/v1/auth/linkedin/callback

# Security. Keep values separate from development and test.
JWT_SECRET=REPLACE_WITH_RANDOM_PRODUCTION_JWT_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_TTL_HOURS=168
STRICT_JWT_AUTH=true
ADMIN_INVITE_TOKEN=REPLACE_WITH_RANDOM_PRODUCTION_ADMIN_TOKEN
# Use either ENCRYPTION_KEYS or legacy ENCRYPTION_KEY, never both.
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
ACTIVE_ENCRYPTION_KEY_ID=1
# Legacy compatibility alternative during a controlled migration:
# ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Worker and upload-job tuning
PUBLISH_WORKER_INTERVAL_SECONDS=30
RECONCILE_WORKER_INTERVAL_SECONDS=5
WEBHOOK_WORKER_INTERVAL_SECONDS=5
SESSION_CLEANUP_INTERVAL_SECONDS=300
ASSET_CLEANUP_INTERVAL_SECONDS=86400
UPLOAD_WORKER_INTERVAL_SECONDS=30
UPLOAD_INGEST_CONCURRENCY=3
YOUTUBE_UPLOAD_CONCURRENCY=4
UPLOAD_LEASE_TTL_SECONDS=60
UPLOAD_HEARTBEAT_INTERVAL_SECONDS=20
UPLOAD_RECLAIM_INTERVAL_SECONDS=30
UPLOAD_RECLAIM_ON_START=true
PUBLISH_HORIZON_DAYS=30
VIDEO_RETENTION_BUFFER_DAYS=7

# Velox integration (set enabled only when the private service is deployed)
VELOX_INTEGRATION_ENABLED=false
VELOX_CONTROL_URL=
VELOX_CONTROL_JWT_SECRET=
VELOX_API_TOKEN=
VELOX_WEBHOOK_SECRET=
VELOX_DOWNLOAD_TIMEOUT_SECONDS=1800
VELOX_MAX_ARTIFACT_BYTES=2147483648
VELOX_CALLBACK_MAX_ATTEMPTS=5
VELOX_CALLBACK_BASE_DELAY_MS=1000

# Production observability and billing
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
METRICS_BASIC_AUTH_USER=REPLACE_WITH_METRICS_USER
METRICS_BASIC_AUTH_PASS=REPLACE_WITH_LONG_RANDOM_METRICS_PASSWORD
METRICS_HOST=127.0.0.1
METRICS_PORT=0
NVIDIA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://app.instaedit.org/dashboard/billing?success=1
STRIPE_CANCEL_URL=https://app.instaedit.org/dashboard/billing?canceled=1
BOOKING_HASH_SECRET=REPLACE_WITH_RANDOM_BOOKING_HASH_SECRET

# Vercel credentials belong in Vercel/GitHub secret storage, not this file.
VERCEL_TOKEN=

# Token refresh sweep — renews dormant OAuth grants before Google's ~6-month inactivity GC.
# 15-minute cadence + 4-month horizon (2 months of margin under the 6-month rule).
TOKEN_REFRESH_SWEEP_INTERVAL_SECONDS=900
TOKEN_REFRESH_SWEEP_HORIZON_DAYS=120
