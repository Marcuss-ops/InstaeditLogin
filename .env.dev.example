# InstaEditLogin — canonical local development environment
#
# Copy to the ignored runtime file before starting local services:
#   cp .env.dev.example .env.dev
#   docker compose --env-file .env.dev -f docker-compose.yml \
#     -f docker-compose.local.yml up --build
#
# Replace every REPLACE_* value in .env.dev. Never commit .env.dev.
# Local Compose uses PostgreSQL and MinIO; do not point this file at production
# databases, buckets, domains, or credentials.

# Application and HTTP
APP_ENV=dev
APP_MODE=dev
API_HOST_PORT=8081
PORT=8080
LOG_LEVEL=info
FRONTEND_URL=https://localhost:8443
CORS_ALLOWED_ORIGINS=https://localhost:8443,http://localhost:5173,http://localhost:4173
COOKIE_DOMAIN=
# Canonical InstaEditor URL. EDITOR_URL remains supported as a legacy fallback.
INSTAEDITOR_URL=https://localhost:8443/dark_editor_v2
EDITOR_URL=https://localhost:8443/dark_editor_v2
TRUSTED_PROXIES=

# PostgreSQL (Compose service name is db)
POSTGRES_USER=instaedit
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=instaedit_login
DATABASE_URL=postgresql://instaedit:REPLACE_WITH_LOCAL_POSTGRES_PASSWORD@db:5432/instaedit_login?sslmode=disable
# Optional host-style fallback for tools that do not use DATABASE_URL.
DB_HOST=db
DB_PORT=5432
DB_USER=instaedit
DB_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
DB_NAME=instaedit_login
DB_SSLMODE=disable

# MinIO (Compose service name is minio)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=instaedit-local
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=instaedit
S3_SECRET_KEY=REPLACE_WITH_LOCAL_MINIO_PASSWORD
MINIO_ROOT_USER=instaedit
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MINIO_PASSWORD
STORAGE_MAX_UPLOAD_BYTES=209715200
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# Meta OAuth (one app shared by Instagram, Facebook, and Threads)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8081/api/v1/auth/meta/callback
INSTAGRAM_REDIRECT_URI=http://localhost:8081/api/v1/auth/instagram/callback
FACEBOOK_REDIRECT_URI=http://localhost:8081/api/v1/auth/facebook/callback
THREADS_REDIRECT_URI=http://localhost:8081/api/v1/auth/threads/callback

# TikTok OAuth
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8081/api/v1/auth/tiktok/callback

# X/Twitter OAuth 2.0 PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8081/api/v1/auth/twitter/callback

# YouTube OAuth and resumable-upload tuning
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8081/api/v1/auth/youtube/callback
YOUTUBE_OAUTH_CLIENT_A_ID=
YOUTUBE_OAUTH_CLIENT_A_SECRET=
YOUTUBE_OAUTH_CLIENT_A_REDIRECT_URI=http://localhost:8081/api/v1/auth/youtube/callback
YOUTUBE_OAUTH_CLIENT_B_ID=
YOUTUBE_OAUTH_CLIENT_B_SECRET=
YOUTUBE_OAUTH_CLIENT_B_REDIRECT_URI=http://localhost:8081/api/v1/auth/youtube/callback
YOUTUBE_UPLOAD_CHUNK_BYTES=16777216
YOUTUBE_UPLOAD_MAX_RETRIES=5
YOUTUBE_UPLOAD_BACKOFF_BASE_MS=1000
YOUTUBE_UPLOAD_BACKOFF_CAP_MS=300000
YOUTUBE_DAILY_QUOTA_LIMIT=300
YOUTUBE_GROUP_VIDEOS_MAX_ACCOUNTS=200
YOUTUBE_GROUP_VIDEOS_MAX_VIDEOS=500
YOUTUBE_GROUP_VIDEOS_CACHE_TTL_SECONDS=300
YOUTUBE_GROUP_VIDEOS_DEFAULT_PAGE_SIZE=50

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8081/api/v1/auth/google-drive/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8081/api/v1/auth/linkedin/callback

# Security. Generate local values with openssl; never reuse production keys.
#   openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_LOCAL_JWT_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_TTL_HOURS=24
STRICT_JWT_AUTH=true
ADMIN_INVITE_TOKEN=REPLACE_WITH_RANDOM_LOCAL_ADMIN_TOKEN
# Use either ENCRYPTION_KEY or the key-ring form, never both.
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
ACTIVE_ENCRYPTION_KEY_ID=1
# Legacy compatibility alternative:
# ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Worker and upload-job tuning
PUBLISH_WORKER_INTERVAL_SECONDS=30
RECONCILE_WORKER_INTERVAL_SECONDS=5
WEBHOOK_WORKER_INTERVAL_SECONDS=5
SESSION_CLEANUP_INTERVAL_SECONDS=300
ASSET_CLEANUP_INTERVAL_SECONDS=86400
UPLOAD_WORKER_INTERVAL_SECONDS=30
UPLOAD_INGEST_CONCURRENCY=3
YOUTUBE_UPLOAD_CONCURRENCY=4
UPLOAD_LEASE_TTL_SECONDS=60
UPLOAD_HEARTBEAT_INTERVAL_SECONDS=20
UPLOAD_RECLAIM_INTERVAL_SECONDS=30
UPLOAD_RECLAIM_ON_START=true
PUBLISH_HORIZON_DAYS=30
VIDEO_RETENTION_BUFFER_DAYS=7

# Velox integration (leave empty to keep the integration disabled)
VELOX_INTEGRATION_ENABLED=false
VELOX_CONTROL_URL=
VELOX_CONTROL_JWT_SECRET=
VELOX_API_TOKEN=
VELOX_WEBHOOK_SECRET=
VELOX_DOWNLOAD_TIMEOUT_SECONDS=1800
VELOX_MAX_ARTIFACT_BYTES=2147483648
VELOX_CALLBACK_MAX_ATTEMPTS=5
VELOX_CALLBACK_BASE_DELAY_MS=1000

# Optional observability and billing
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=
METRICS_HOST=
METRICS_PORT=0
NVIDIA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard/billing?success=1
STRIPE_CANCEL_URL=http://localhost:5173/dashboard/billing?canceled=1
BOOKING_HASH_SECRET=

# Optional Vercel CLI credential. Prefer the Vercel dashboard/secret manager.
VERCEL_TOKEN=

# Token refresh sweep — renews dormant OAuth grants before Google's ~6-month inactivity GC.
# 15-minute cadence + 4-month horizon (2 months of margin under the 6-month rule).
TOKEN_REFRESH_SWEEP_INTERVAL_SECONDS=900
TOKEN_REFRESH_SWEEP_HORIZON_DAYS=120
