{
  "framework": "vite",
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "instaedit.org" }],
      "destination": "https://app.instaedit.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.instaedit.org" }],
      "destination": "https://app.instaedit.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.instaedit.org/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
