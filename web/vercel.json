{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.instaedit.org/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
