# InstaEdit frontend — canonical Vite environment
#
# Local development:
#   cp web/.env.example web/.env.local
# Production values belong in the Vercel project environment settings, not Git.

# Backend API base URL.
# Local:      http://localhost:8080
# Production: https://api.instaedit.org
VITE_API_BASE_URL=http://localhost:8080

# Set exactly "true" only for a frontend-only preview with mock data.
VITE_DEMO_MODE=false

# Optional Google Calendar booking URL override. Empty uses the code default.
VITE_BOOKING_URL=
